  "entries": [
    {
      "id": "entry-time-seam-chronicles",
      "name": "主时间流",
      "type": "world",
      "parentId": "",
      "status": "draft",
      "summary": "时间局失联后，未来求救信号与已记录的牺牲事件出现矛盾。",
      "body": "时间框架：事件按发生时间、观察时间和记录时间分别标注。来自未来的文件可能被改写，也可能来自另一条分支。\\n\\n改动成本：穿梭会留下锚点、记忆偏差或因果回响；修改并不自动覆盖所有观察者的历史。\\n\\n创作留白：主时间流是否唯一、失联队员是否仍处于同一分支，以及谁有权决定修复哪条时间线。",
      "customFields": {},
