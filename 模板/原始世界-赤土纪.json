  "entries": [
    {
      "id": "entry-red-earth-age",
      "name": "赤土河谷",
      "type": "world",
      "parentId": "",
      "status": "draft",
      "summary": "水源重现引发迁徙与盟约争端，洞穴壁画留下了无法解释的旧灾痕迹。",
      "body": "生存框架：季节、降雨、兽群迁徙和可携带的工具决定族群活动范围。任何远行都需要水源、火种和可靠的同行者。\\n\\n知识传承：故事、歌谣、身体技艺和洞穴图像承担记录功能；不同讲述者可能保存同一事件的不同部分。\\n\\n创作留白：旧灾是否与河谷异常有关、部族之间能否继续共享水源，以及新工具会改变怎样的生活。",
      "customFields": {},
